{%- style -%}
  .password-page-section {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
    background-color: var(--color-background, #faf7f2);
    position: relative;
    overflow: hidden;
  }

  .password-bg-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, rgba(201,160,80,0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .password-card {
    width: 100%;
    max-width: 680px;
    background-color: #ffffff;
    border: 1px solid var(--color-border, #e5e0d8);
    box-shadow: 0 20px 50px rgba(0,0,0,0.06);
    padding: clamp(2.5rem, 6vw, 4.5rem);
    text-align: {{ section.settings.text_alignment | default: 'center' }};
    position: relative;
    z-index: 2;
  }

  .password-card--align-left { text-align: left; }
  .password-card--align-center { text-align: center; }
  .password-card--align-right { text-align: right; }

  /* Logo */
  .password-logo {
    font-family: var(--font-heading-family);
    font-size: clamp(2.2rem, 4vw, 3rem);
    font-weight: 300;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
    display: block;
    margin-bottom: 0.5rem;
  }

  .password-logo-img {
    max-width: {{ section.settings.logo_size | default: 180 }}px;
    height: auto;
    object-fit: contain;
    margin-bottom: 1rem;
  }

  .password-tagline {
    font-family: var(--font-heading-family);
    font-size: 1.15rem;
    font-style: italic;
    color: var(--color-accent, #c9a050);
    margin-bottom: 2rem;
  }

  /* Title & Subtitle */
  .password-title--small { font-size: clamp(1.8rem, 3vw, 2.4rem); }
  .password-title--medium { font-size: clamp(2.2rem, 4vw, 3.2rem); }
  .password-title--large { font-size: clamp(2.6rem, 5vw, 3.8rem); }
  .password-title--xlarge { font-size: clamp(3rem, 6vw, 4.5rem); }

  .password-title {
    font-family: var(--font-heading-family);
    font-weight: 300;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .password-subtitle {
    font-family: var(--font-body-family);
    font-size: 0.92rem;
    color: #555555;
    line-height: 1.65;
    max-width: 520px;
    margin: 0 auto 2.5rem auto;
  }

  .password-card--align-left .password-subtitle { margin-left: 0; }
  .password-card--align-right .password-subtitle { margin-right: 0; }

  /* Newsletter Form */
  .password-newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    max-width: 480px;
    margin: 0 auto 2rem auto;
  }

  .password-card--align-left .password-newsletter-form { margin-left: 0; }
  .password-card--align-right .password-newsletter-form { margin-right: 0; }

  @media screen and (min-width: 600px) {
    .password-newsletter-form {
      flex-direction: row;
    }
  }

  .password-email-input {
    flex-grow: 1;
    padding: 0.95rem 1.25rem;
    font-family: var(--font-body-family);
    font-size: 0.88rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-background);
    color: var(--color-text);
  }

  .password-email-input:focus {
    outline: none;
    border-color: var(--color-text);
  }

  .password-submit-btn {
    padding: 0.95rem 1.6rem;
    font-family: var(--font-body-family);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    background-color: #1c1c1c;
    color: #ffffff;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.25s ease;
  }

  .password-submit-btn:hover {
    opacity: 0.9;
  }

  /* Store Owner Login Trigger & Icon Position */
  .password-owner-trigger {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    justify-content: {{ section.settings.icon_position | default: 'center' }};
  }

  .owner-modal-btn {
    background: transparent;
    border: none;
    font-family: var(--font-body-family);
    font-size: 0.76rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: color 0.25s ease;
  }

  .owner-modal-btn:hover {
    color: var(--color-text);
  }

  .password-lock-icon {
    width: {{ section.settings.icon_size | default: 16 }}px;
    height: {{ section.settings.icon_size | default: 16 }}px;
    stroke: currentColor;
    stroke-width: 1.6;
    fill: none;
  }

  /* Glassmorphic Password Modal */
  .password-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(8px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    padding: 1.5rem;
  }

  .password-modal-backdrop.active {
    display: flex;
  }

  .password-modal-content {
    background: #ffffff;
    border: 1px solid var(--color-accent);
    padding: 2.5rem;
    width: 100%;
    max-width: 440px;
    text-align: center;
    position: relative;
  }

  .password-modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: transparent;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
  }
{%- endstyle -%}

<div class="password-page-section">
  <div class="password-bg-overlay"></div>

  <div class="password-card password-card--align-{{ section.settings.text_alignment }}">
    <!-- Brand Logo -->
    {% if section.settings.logo != blank %}
      <img src="{{ section.settings.logo | image_url: width: 500 }}" alt="{{ shop.name | escape }}" class="password-logo-img">
    {% else %}
      <a href="/" class="password-logo">Daisy Chains</a>
    {% endif %}
    
    <div class="password-tagline">Baroque Designs &amp; Intention Treasures</div>

    <!-- Opening Headline -->
    <h1 class="password-title password-title--{{ section.settings.heading_size | default: 'medium' }}">
      {{ section.settings.title | default: 'Opening Soon — Something Extraordinary is Being Handcrafted.' | escape }}
    </h1>

    <div class="password-subtitle">
      {{ section.settings.subtitle | default: 'Be the first to unlock our upcoming handcrafted baroque pearl collection & California intention chokers. Sign up below for VIP early access & 10% off your first order.' | escape }}
    </div>

    <!-- VIP Newsletter Form -->
    {% if section.settings.show_newsletter %}
      {% form 'customer', class: 'password-newsletter-form' %}
        {% if form.posted_successfully? %}
          <div style="background:#f4f0ea; border:1px solid #c9a050; padding:1rem; font-size:0.88rem; width:100%;">
            ✨ Thank you for joining! Your VIP access code is on its way.
          </div>
        {% else %}
          <input type="hidden" name="contact[tags]" value="newsletter, vip_prelaunch">
          <input type="email" name="contact[email]" class="password-email-input" placeholder="Enter your email address..." required aria-label="VIP Email Sign Up">
          <button type="submit" class="password-submit-btn">Unlock VIP Access &rarr;</button>
        {% endif %}
      {% endform %}
    {% endif %}

    <!-- Storefront Password Entry Trigger -->
    <div class="password-owner-trigger">
      <button type="button" class="owner-modal-btn" onclick="document.getElementById('PasswordModal').classList.add('active');">
        <svg class="password-lock-icon" viewBox="0 0 24 24">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span>Enter Store Using Password</span>
      </button>
    </div>
  </div>
</div>

<!-- Glassmorphic Storefront Password Entry Modal -->
<div class="password-modal-backdrop" id="PasswordModal">
  <div class="password-modal-content">
    <button type="button" class="password-modal-close" onclick="document.getElementById('PasswordModal').classList.remove('active');">&times;</button>
    
    <h3 style="font-family:var(--font-heading-family); font-size:1.8rem; font-weight:300; margin-bottom:0.5rem;">Storefront Password</h3>
    <p style="font-family:var(--font-body-family); font-size:0.84rem; color:var(--color-muted); margin-bottom:1.5rem;">Enter password to unlock store access for testing or VIP previews.</p>

    {% form 'storefront_password' %}
      {% if form.errors %}
        <div style="color:#b00000; font-size:0.8rem; margin-bottom:1rem;">Incorrect password. Please try again.</div>
      {% endif %}

      <input type="password" name="password" class="password-email-input" style="width:100%; margin-bottom:1rem;" placeholder="Enter storefront password..." required>
      <button type="submit" class="password-submit-btn" style="width:100%;">Enter Store &rarr;</button>
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Password Pre-Launch Page",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Custom Brand Logo" },
    {
      "type": "range",
      "id": "logo_size",
      "min": 80,
      "max": 320,
      "step": 10,
      "unit": "px",
      "label": "Logo Width",
      "default": 180
    },
    { "type": "text", "id": "title", "label": "Title", "default": "Opening Soon — Something Extraordinary is Being Handcrafted." },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "xlarge", "label": "Extra Large" }
      ],
      "default": "medium"
    },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle Prose", "default": "Be the first to unlock our upcoming handcrafted baroque pearl collection & California intention chokers. Sign up below for VIP early access & 10% off your first order." },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show VIP Pre-Launch Email Capture", "default": true },
    {
      "type": "header",
      "content": "Icon Sizing & Position Settings"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "Password Lock Icon Size",
      "default": 16
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "Lock Button Position Alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Card Content Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    }
  ],
  "presets": [
    { "name": "Password Pre-Launch Page" }
  ]
}
{% endschema %}
