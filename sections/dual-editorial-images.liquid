{%- style -%}
  .dual-images-section {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    background-color: var(--color-background);
  }
  .dual-images-grid {
    display: grid;
    grid-template-columns: 1fr;
    width: 100%;
  }
  .dual-images-grid--gap-zero { gap: 0 !important; }
  .dual-images-grid--gap-tiny { gap: 0.5rem !important; }

  @media screen and (min-width: 768px) {
    .dual-images-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .dual-image-card {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: block;
    background-color: var(--color-surface-warm);
    text-decoration: none;
    color: #FFFFFF;
  }

  /* Height options */
  .dual-image-card--small { height: 50vh; min-height: 400px; }
  .dual-image-card--medium { height: 70vh; min-height: 550px; }
  .dual-image-card--large { height: 85vh; min-height: 650px; }
  .dual-image-card--adapt { aspect-ratio: 3 / 4; height: auto; }

  @media screen and (max-width: 767px) {
    .dual-image-card--small { height: 45vh; min-height: 350px; }
    .dual-image-card--medium { height: 60vh; min-height: 450px; }
    .dual-image-card--large { height: 75vh; min-height: 520px; }
  }

  .dual-image-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .dual-image-card:hover .dual-image-card__img {
    transform: scale(1.05);
  }

  .dual-image-card__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(0,0,0,0) 60%, rgba(0,0,0,0.4) 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .dual-image-card:hover .dual-image-card__overlay {
    opacity: 1;
  }

  .dual-image-card__title {
    position: absolute;
    bottom: 2rem;
    left: 2rem;
    z-index: 2;
    font-family: var(--font-heading-family);
    font-size: 1.4rem;
    font-weight: 300;
    color: #FFFFFF;
    margin: 0;
  }
{%- endstyle -%}

<div class="dual-images-section">
  <div class="dual-images-grid dual-images-grid--gap-{{ section.settings.gap_size }}">
    <!-- Image 1 -->
    <a href="{{ section.settings.link_1 }}" class="dual-image-card dual-image-card--{{ section.settings.card_height }}">
      {% if section.settings.image_1 != blank %}
        <img src="{{ section.settings.image_1 | image_url: width: 1400 }}" alt="{{ section.settings.title_1 | escape }}" class="dual-image-card__img" loading="lazy">
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'dual-image-card__img placeholder-svg' }}
      {% endif %}
      {% if section.settings.title_1 != blank %}
        <div class="dual-image-card__overlay"></div>
        <h3 class="dual-image-card__title">{{ section.settings.title_1 | escape }}</h3>
      {% endif %}
    </a>

    <!-- Image 2 -->
    <a href="{{ section.settings.link_2 }}" class="dual-image-card dual-image-card--{{ section.settings.card_height }}">
      {% if section.settings.image_2 != blank %}
        <img src="{{ section.settings.image_2 | image_url: width: 1400 }}" alt="{{ section.settings.title_2 | escape }}" class="dual-image-card__img" loading="lazy">
      {% else %}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'dual-image-card__img placeholder-svg' }}
      {% endif %}
      {% if section.settings.title_2 != blank %}
        <div class="dual-image-card__overlay"></div>
        <h3 class="dual-image-card__title">{{ section.settings.title_2 | escape }}</h3>
      {% endif %}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Dual Editorial Images",
  "settings": [
    {
      "type": "select",
      "id": "card_height",
      "label": "Card Height",
      "options": [
        { "value": "small", "label": "Small (50vh)" },
        { "value": "medium", "label": "Medium (70vh)" },
        { "value": "large", "label": "Large (85vh)" },
        { "value": "adapt", "label": "Adapt to ratio (3:4)" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "gap_size",
      "label": "Gap between images",
      "options": [
        { "value": "zero", "label": "No Gap (0px)" },
        { "value": "tiny", "label": "Tiny Gap (8px)" }
      ],
      "default": "tiny"
    },
    { "type": "header", "content": "Left Image" },
    { "type": "image_picker", "id": "image_1", "label": "Image 1" },
    { "type": "text", "id": "title_1", "label": "Title 1 (Optional)" },
    { "type": "url", "id": "link_1", "label": "Link 1" },
    { "type": "header", "content": "Right Image" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2" },
    { "type": "text", "id": "title_2", "label": "Title 2 (Optional)" },
    { "type": "url", "id": "link_2", "label": "Link 2" }
  ],
  "presets": [ { "name": "Dual Editorial Images" } ]
}
{% endschema %}
