{%- style -%}
  .categories-fullwidth-section {
    padding: 0 !important;
    margin: 0 !important;
    width: 100% !important;
    max-width: 100% !important;
    overflow: hidden;
  }
  .categories-fullwidth-header {
    text-align: center;
    padding: 2.5rem 1rem 1.5rem 1rem;
    background-color: var(--color-background);
  }
  .categories-fullwidth-header h2 {
    font-family: var(--font-heading-family);
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 300;
    margin: 0;
  }
  .categories-fullwidth-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    width: 100%;
  }
  @media screen and (min-width: 768px) {
    .categories-fullwidth-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .category-card-tall {
    position: relative;
    height: 75vh;
    min-height: 600px;
    width: 100%;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    text-decoration: none;
    color: #FFFFFF;
    background-color: var(--color-surface-warm);
    border-radius: 0 !important;
    margin: 0 !important;
  }
  @media screen and (max-width: 767px) {
    .category-card-tall {
      height: 65vh;
      min-height: 480px;
    }
  }
  .category-card-tall__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .category-card-tall:hover .category-card-tall__image {
    transform: scale(1.08);
  }
  .category-card-tall__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(0,0,0,0) 50%, rgba(0,0,0,0.5) 100%);
  }
  .category-card-tall__content {
    position: relative;
    z-index: 2;
    padding: 2rem 1.5rem;
    width: 100%;
  }
  .category-card-tall__title {
    font-family: var(--font-heading-family);
    font-size: clamp(1.3rem, 2vw, 1.8rem);
    font-weight: 300;
    color: #FFFFFF;
    margin: 0 0 0.4rem 0;
    letter-spacing: 0.03em;
    line-height: 1.1;
  }
  .category-card-tall__link {
    font-family: var(--font-body-family);
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #FFFFFF;
    position: relative;
    display: inline-block;
    padding-bottom: 2px;
  }
  .category-card-tall__link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: #FFFFFF;
    transition: transform 0.3s ease;
    transform-origin: right;
  }
  .category-card-tall:hover .category-card-tall__link::after {
    transform: scaleX(0);
  }
{%- endstyle -%}

<div class="categories-fullwidth-section">
  {% if section.settings.title != blank %}
    <div class="categories-fullwidth-header">
      <h2>{{ section.settings.title | escape }}</h2>
    </div>
  {% endif %}
  <div class="categories-fullwidth-grid">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link }}" class="category-card-tall" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.title | escape }}" class="category-card-tall__image" loading="lazy">
        {% else %}
          {{ 'collection-1' | placeholder_svg_tag: 'category-card-tall__image placeholder-svg' }}
        {% endif %}
        <div class="category-card-tall__overlay"></div>
        <div class="category-card-tall__content">
          <h3 class="category-card-tall__title">{{ block.settings.title | escape }}</h3>
          <span class="category-card-tall__link">Shop Collection</span>
        </div>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Category Grid",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "title", "label": "Section Title" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Necklaces" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Grid",
      "blocks": [
        { "type": "category", "settings": { "title": "Necklaces" } },
        { "type": "category", "settings": { "title": "Bikini Charms" } },
        { "type": "category", "settings": { "title": "Bracelets" } },
        { "type": "category", "settings": { "title": "Symbols & Stories" } }
      ]
    }
  ]
}
{% endschema %}
