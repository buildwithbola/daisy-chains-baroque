{%- style -%}
  .services-grid-section {
    padding-top: clamp(2rem, 5vw, 5rem);
    padding-bottom: clamp(2rem, 5vw, 5rem);
    width: 100%;
    margin: 0 auto;
    {% if section.settings.full_width %}
      max-width: 100%;
      padding-left: clamp(0.5rem, 2vw, 2rem);
      padding-right: clamp(0.5rem, 2vw, 2rem);
    {% else %}
      max-width: {{ section.settings.max_width | default: 1440 }}px;
      padding-left: clamp(1.25rem, 3vw, 3rem);
      padding-right: clamp(1.25rem, 3vw, 3rem);
    {% endif %}
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ section.settings.grid_gap_mobile | default: 12 }}px;
    width: 100%;
  }

  @media screen and (min-width: 900px) {
    .services-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
      gap: {{ section.settings.grid_gap_desktop | default: 20 }}px;
    }
  }

  .service-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
  }

  .service-card__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.aspect_ratio | default: '3 / 4' }};
    overflow: hidden;
    margin-bottom: 0.85rem;
    background-color: var(--color-surface-warm);
    border: 1px solid var(--color-border);
  }

  .service-card__image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .service-card:hover .service-card__image-wrapper img {
    transform: scale(1.05);
  }

  .service-card__title--small { font-size: 1.1rem; }
  .service-card__title--medium { font-size: 1.35rem; }
  .service-card__title--large { font-size: 1.6rem; }
  .service-card__title--xlarge { font-size: 1.85rem; }

  .service-card__title {
    font-family: var(--font-heading-family);
    font-weight: 300;
    margin: 0 0 0.35rem 0;
    letter-spacing: 0.02em;
    color: var(--color-text);
  }

  .service-card__link--small { font-size: 0.7rem; }
  .service-card__link--medium { font-size: 0.78rem; }
  .service-card__link--large { font-size: 0.9rem; }
  .service-card__link--xlarge { font-size: 1.05rem; }

  .service-card__link {
    font-family: var(--font-body-family);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    position: relative;
    display: inline-block;
    width: max-content;
    padding-bottom: 2px;
    color: var(--color-text);
  }

  .service-card__link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: var(--color-text);
    transition: transform 0.3s ease;
    transform-origin: right;
  }

  .service-card:hover .service-card__link::after {
    transform: scaleX(0);
  }
{%- endstyle -%}

<div class="services-grid-section">
  <div class="services-grid">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link }}" class="service-card" {{ block.shopify_attributes }}>
        <div class="service-card__image-wrapper">
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 1000 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
        <h3 class="service-card__title service-card__title--{{ section.settings.title_size | default: 'medium' }}">{{ block.settings.title | escape }}</h3>
        <span class="service-card__link service-card__link--{{ section.settings.button_size | default: 'medium' }}">{{ block.settings.link_label | escape }}</span>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Services Grid",
  "max_blocks": 6,
  "settings": [
    { "type": "checkbox", "id": "full_width", "label": "Full Bleed Width", "default": false },
    { "type": "number", "id": "max_width", "label": "Max Container Width (px)", "default": 1440 },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Desktop Columns",
      "default": 4
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Card Image Aspect Ratio",
      "options": [
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" }
      ],
      "default": "3 / 4"
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Card Heading Text Size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "xlarge", "label": "Extra Large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "Button / Link Text Size",
      "options": [
        { "value": "small", "label": "Small (0.70rem)" },
        { "value": "medium", "label": "Medium (0.78rem)" },
        { "value": "large", "label": "Large (0.90rem)" },
        { "value": "xlarge", "label": "Extra Large (1.05rem)" }
      ],
      "default": "medium"
    },
    { "type": "range", "id": "grid_gap_desktop", "min": 8, "max": 48, "step": 2, "unit": "px", "label": "Desktop Grid Gap (px)", "default": 20 },
    { "type": "range", "id": "grid_gap_mobile", "min": 4, "max": 32, "step": 2, "unit": "px", "label": "Mobile Grid Gap (px)", "default": 12 }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Heading", "default": "Custom Treasures" },
        { "type": "text", "id": "link_label", "label": "Link Text", "default": "Design Your Own" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Services Grid",
      "blocks": [
        { "type": "service", "settings": { "title": "Custom Treasures", "link_label": "Design Your Own" } },
        { "type": "service", "settings": { "title": "Treasure Parties", "link_label": "Host a Workshop" } },
        { "type": "service", "settings": { "title": "Meanings & Symbols", "link_label": "Explore the Guide" } },
        { "type": "service", "settings": { "title": "Materials & Care", "link_label": "Learn More" } }
      ]
    }
  ]
}
{% endschema %}
