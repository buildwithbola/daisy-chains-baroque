{%- style -%}
  .about-section {
    padding: clamp(3rem, 6vw, 6rem) clamp(1.5rem, 4vw, 4rem);
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Breadcrumb */
  .about-breadcrumb {
    font-family: var(--font-body-family);
    font-size: 0.76rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-muted);
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
  }

  .about-breadcrumb--align-left { justify-content: flex-start; }
  .about-breadcrumb--align-center { justify-content: center; }
  .about-breadcrumb--align-right { justify-content: flex-end; }

  .about-breadcrumb a {
    color: var(--color-muted);
    text-decoration: none;
  }

  .about-breadcrumb a:hover {
    color: var(--color-text);
  }

  /* Editorial Hero Header */
  .about-hero {
    width: 100%;
    max-width: 850px;
    margin-bottom: clamp(3.5rem, 6vw, 5rem);
  }

  .about-hero--position-left { margin-left: 0; margin-right: auto; }
  .about-hero--position-center { margin-left: auto; margin-right: auto; }
  .about-hero--position-right { margin-left: auto; margin-right: 0; }

  .about-hero--align-left { text-align: left; }
  .about-hero--align-center { text-align: center; }
  .about-hero--align-right { text-align: right; }

  .about-hero__title--small { font-size: clamp(2rem, 3.5vw, 2.8rem); }
  .about-hero__title--medium { font-size: clamp(2.5rem, 5vw, 3.8rem); }
  .about-hero__title--large { font-size: clamp(3rem, 6vw, 4.8rem); }
  .about-hero__title--xlarge { font-size: clamp(3.5rem, 7.5vw, 5.5rem); }

  .about-hero__title {
    font-family: var(--font-heading-family);
    font-weight: 300;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .about-hero__greeting {
    font-family: var(--font-heading-family);
    font-style: italic;
    color: var(--color-text);
    font-size: clamp(1.2rem, 2.2vw, 1.6rem);
    margin-bottom: 1rem;
  }

  /* Story Layout */
  .about-content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: start;
    margin-bottom: clamp(4rem, 7vw, 6rem);
  }

  @media screen and (min-width: 900px) {
    .about-content-grid {
      grid-template-columns: 4.5fr 7.5fr;
      gap: 4.5rem;
    }
  }

  .about-portrait-sticky {
    position: sticky;
    top: 6rem;
  }

  .about-portrait-wrapper {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: var(--color-surface-warm);
    border: 1px solid var(--color-border);
    margin-bottom: 1.25rem;
  }

  .about-portrait-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-portrait-caption {
    font-family: var(--font-body-family);
    font-size: 0.8rem;
    color: var(--color-muted);
    text-align: center;
    line-height: 1.5;
  }

  .about-story-prose {
    font-family: var(--font-body-family);
    font-size: 0.95rem;
    color: #444444;
    line-height: 1.8;
  }

  .about-story-prose p {
    margin-bottom: 1.5rem;
  }

  .about-story-prose h2 {
    font-family: var(--font-heading-family);
    font-size: 1.75rem;
    font-weight: 300;
    margin: 2.25rem 0 1rem 0;
    color: var(--color-text);
  }

  .about-signature-block {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .about-signature-name {
    font-family: var(--font-heading-family);
    font-size: 1.6rem;
    font-weight: 300;
    margin-bottom: 0.25rem;
    color: var(--color-text);
  }

  .about-signature-title {
    font-family: var(--font-body-family);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-muted);
  }
{%- endstyle -%}

<div class="about-section">
  <!-- Breadcrumb -->
  <div class="about-breadcrumb about-breadcrumb--align-{{ section.settings.text_alignment }}">
    <a href="/">Home</a>
    <span style="font-size:0.5rem; opacity:0.4;">&#9679;</span>
    <span>About Daisy Chains</span>
  </div>

  <!-- Hero Header -->
  <div class="about-hero about-hero--position-{{ section.settings.content_position }} about-hero--align-{{ section.settings.text_alignment }}">
    <h1 class="about-hero__title about-hero__title--{{ section.settings.title_size }}">{{ section.settings.title | escape }}</h1>
    
    {% if section.settings.greeting != blank %}
      <div class="about-hero__greeting">
        "{{ section.settings.greeting | escape }}"
      </div>
    {% endif %}
  </div>

  <!-- Main Story Content Grid -->
  <div class="about-content-grid">
    <!-- Left Column: Founder Portrait -->
    <div class="about-portrait-sticky">
      <div class="about-portrait-wrapper">
        {% if section.settings.founder_image != blank %}
          <img src="{{ section.settings.founder_image | image_url: width: 900 }}" alt="Jenny Higgins - Founder & Designer" loading="lazy">
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
      <div class="about-portrait-caption">
        <strong>Jenny Higgins</strong><br>Founder, Designer &amp; Artisan Maker<br>California Studio
      </div>
    </div>

    <!-- Right Column: Story Prose -->
    <div class="about-story-prose">
      {{ section.settings.story_text }}

      <div class="about-signature-block">
        <div class="about-signature-name">Jenny Higgins</div>
        <div class="about-signature-title">Founder, Designer &amp; Maker &bull; Daisy Chains Baroque Designs</div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About / Founder Story",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "About Daisy Chains" },
    {
      "type": "select",
      "id": "title_size",
      "label": "Title Size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "xlarge", "label": "Extra Large" }
      ],
      "default": "medium"
    },
    { "type": "text", "id": "greeting", "label": "Founder Greeting", "default": "Hi, I'm Jenny, the founder and designer behind Daisy Chains Baroque Designs." },
    { "type": "image_picker", "id": "founder_image", "label": "Founder Portrait Image" },
    {
      "type": "richtext",
      "id": "story_text",
      "label": "Founder Story Text",
      "default": "<p>People often ask about the name Daisy Chains...</p>"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "About / Founder Story"
    }
  ]
}
{% endschema %}
