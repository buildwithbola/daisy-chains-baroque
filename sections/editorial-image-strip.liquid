{%- style -%}
  .image-strip-section {
    padding: 1.5rem 0 0 0;
    overflow: hidden;
    background-color: var(--color-background);
  }
  .image-strip {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }
  @media screen and (min-width: 750px) {
    .image-strip {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  .image-strip__item {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: var(--color-surface-warm);
    position: relative;
  }
  .image-strip__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .image-strip__item:hover img {
    transform: scale(1.05);
  }
{%- endstyle -%}

<div class="image-strip-section">
  <div class="image-strip">
    {% for block in section.blocks %}
      <div class="image-strip__item" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 600 }}" alt="Daisy Chains Editorial" loading="lazy">
        {% else %}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Editorial Image Strip",
  "max_blocks": 5,
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial Image Strip",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
