{%- style -%}
  .editorial-banner-section {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--color-surface-warm);
    display: flex;
    padding: 0;
  }

  /* Height Options */
  .editorial-banner--height-small { height: 50vh; min-height: 400px; }
  .editorial-banner--height-medium { height: 70vh; min-height: 550px; }
  .editorial-banner--height-large { height: 85vh; min-height: 650px; }
  .editorial-banner--height-full { height: 100vh; min-height: 700px; }
  .editorial-banner--height-adapt { height: auto; min-height: auto; aspect-ratio: 16 / 9; }

  @media screen and (max-width: 767px) {
    .editorial-banner--height-small { height: 40vh; min-height: 320px; }
    .editorial-banner--height-medium { height: 60vh; min-height: 450px; }
    .editorial-banner--height-large { height: 75vh; min-height: 520px; }
    .editorial-banner--height-adapt { aspect-ratio: 4 / 5; }
  }

  /* Content Position Options */
  .editorial-banner--top-left { align-items: flex-start; justify-content: flex-start; }
  .editorial-banner--top-center { align-items: flex-start; justify-content: center; }
  .editorial-banner--top-right { align-items: flex-start; justify-content: flex-end; }
  .editorial-banner--middle-left { align-items: center; justify-content: flex-start; }
  .editorial-banner--middle-center { align-items: center; justify-content: center; }
  .editorial-banner--middle-right { align-items: center; justify-content: flex-end; }
  .editorial-banner--bottom-left { align-items: flex-end; justify-content: flex-start; }
  .editorial-banner--bottom-center { align-items: flex-end; justify-content: center; }
  .editorial-banner--bottom-right { align-items: flex-end; justify-content: flex-end; }

  /* Text Alignment */
  .editorial-banner__content--left { text-align: left; }
  .editorial-banner__content--center { text-align: center; }
  .editorial-banner__content--right { text-align: right; }

  .editorial-banner__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .editorial-banner__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(0,0,0,0.5) 100%);
  }

  .editorial-banner__content {
    position: relative;
    z-index: 2;
    color: #FFFFFF;
    max-width: 600px;
    padding: clamp(2rem, 5vw, 4.5rem);
  }

  .editorial-banner__heading--small { font-size: clamp(1.1rem, 2vw, 1.5rem); }
  .editorial-banner__heading--medium { font-size: clamp(1.4rem, 2.5vw, 2.2rem); }
  .editorial-banner__heading--large { font-size: clamp(1.8rem, 3.5vw, 3rem); }

  .editorial-banner__heading {
    font-family: var(--font-heading-family);
    font-weight: 300;
    line-height: 1.25;
    margin-bottom: 0.75rem;
    color: #FFFFFF;
    letter-spacing: 0.03em;
  }

  .editorial-banner__subtext {
    font-family: var(--font-body-family);
    font-size: 0.9rem;
    font-weight: 300;
    margin-bottom: 1.25rem;
    color: rgba(255,255,255,0.9);
  }

  .editorial-banner__link {
    font-family: var(--font-body-family);
    font-size: 0.78rem;
    font-weight: 500;
    text-transform: lowercase;
    letter-spacing: 0.08em;
    color: #FFFFFF;
    position: relative;
    display: inline-block;
    padding-bottom: 2px;
    text-decoration: none;
  }

  .editorial-banner__link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: #FFFFFF;
    transition: transform 0.35s ease;
    transform-origin: right;
  }

  .editorial-banner__link:hover::after {
    transform: scaleX(0);
  }
{%- endstyle -%}

<div class="editorial-banner-section editorial-banner--height-{{ section.settings.banner_height }} editorial-banner--{{ section.settings.content_position }}">
  {% if section.settings.image != blank %}
    <img src="{{ section.settings.image | image_url: width: 2400 }}" alt="{{ section.settings.heading | escape }}" class="editorial-banner__image" loading="lazy">
  {% else %}
    {{ 'lifestyle-2' | placeholder_svg_tag: 'editorial-banner__image placeholder-svg' }}
  {% endif %}
  <div class="editorial-banner__overlay"></div>
  
  <div class="editorial-banner__content editorial-banner__content--{{ section.settings.text_alignment }}">
    {% if section.settings.heading != blank %}
      <h2 class="editorial-banner__heading editorial-banner__heading--{{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    {% if section.settings.subtext != blank %}
      <p class="editorial-banner__subtext">{{ section.settings.subtext | escape }}</p>
    {% endif %}
    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link }}" class="editorial-banner__link">
        {{ section.settings.button_label | escape }}
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Editorial Banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Banner Image" },
    {
      "type": "select",
      "id": "banner_height",
      "label": "Banner Height",
      "options": [
        { "value": "small", "label": "Small (50vh)" },
        { "value": "medium", "label": "Medium (70vh)" },
        { "value": "large", "label": "Large (85vh)" },
        { "value": "full", "label": "Full Screen (100vh)" },
        { "value": "adapt", "label": "Adapt to image ratio" }
      ],
      "default": "large"
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Found by the water edit" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "small"
    },
    { "type": "textarea", "id": "subtext", "label": "Subtext" },
    { "type": "text", "id": "button_label", "label": "Button Label", "default": "shop now" },
    { "type": "url", "id": "button_link", "label": "Button Link" },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content Position",
      "options": [
        { "value": "top-left", "label": "Top Left" },
        { "value": "top-center", "label": "Top Center" },
        { "value": "top-right", "label": "Top Right" },
        { "value": "middle-left", "label": "Middle Left" },
        { "value": "middle-center", "label": "Middle Center" },
        { "value": "middle-right", "label": "Middle Right" },
        { "value": "bottom-left", "label": "Bottom Left" },
        { "value": "bottom-center", "label": "Bottom Center" },
        { "value": "bottom-right", "label": "Bottom Right" }
      ],
      "default": "bottom-left"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    }
  ],
  "presets": [ { "name": "Editorial Banner" } ]
}
{% endschema %}
