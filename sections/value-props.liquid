{%- style -%}
  .value-props {
    background-color: #faf9f6; /* Very light sand/warm white */
    padding: 4rem 2rem;
  }
  .value-props__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    text-align: center;
  }
  .value-prop__icon {
    font-size: 2rem;
    margin-bottom: 1rem;
    color: var(--color-accent);
  }
{%- endstyle -%}

<div class="value-props">
  <div class="value-props__grid">
    {% for block in section.blocks %}
      <div class="value-prop" {{ block.shopify_attributes }}>
        {% if block.settings.icon != blank %}
          <div class="value-prop__icon">
            {{ block.settings.icon }}
          </div>
        {% endif %}
        <h4>{{ block.settings.title | escape }}</h4>
        <p>{{ block.settings.text | escape }}</p>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Value Propositions",
  "settings": [],
  "blocks": [
    {
      "type": "value_prop",
      "name": "Value Proposition",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji or SVG Icon",
          "default": "✨"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Handcrafted"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Designed and handcrafted with intention in California."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Value Propositions",
      "blocks": [
        { "type": "value_prop" },
        { "type": "value_prop" },
        { "type": "value_prop" }
      ]
    }
  ]
}
{% endschema %}
