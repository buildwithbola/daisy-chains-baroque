{% schema %}
{
  "name": "Product Information",
  "settings": [
    {
      "type": "select",
      "id": "desktop_media_layout",
      "label": "Desktop Media Layout",
      "options": [
        { "value": "stacked_2col", "label": "Stacked 2-Column Grid" },
        { "value": "stacked_1col", "label": "Stacked 1-Column" }
      ],
      "default": "stacked_2col"
    },
    {
      "type": "select",
      "id": "desktop_media_position",
      "label": "Desktop Media Position",
