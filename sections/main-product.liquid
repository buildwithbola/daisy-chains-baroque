            { "value": "truck", "label": "Delivery Truck" },
            { "value": "package", "label": "Eco Package" },
            { "value": "leaf", "label": "Organic Leaf" }
          ],
          "default": "truck"
        },
        { "type": "image_picker", "id": "shipping_custom_icon", "label": "Custom Shipping Icon Image (Optional)" },
        { "type": "text", "id": "shipping_text", "label": "Shipping Text", "default": "Complimentary carbon-neutral shipping on orders over $150." }
      ]
    },
    {
      "type": "trust_badges",
