          "options": [
            { "value": "sparkle", "label": "Handmade Sparkles" },
            { "value": "leaf", "label": "Organic Leaf" },
            { "value": "package", "label": "Eco Package" },
            { "value": "heart", "label": "Made with Love (Heart)" },
            { "value": "gem", "label": "Natural Gem / Pearl" }
          ],
          "default": "sparkle"
        },
        { "type": "image_picker", "id": "badge_2_custom_icon", "label": "Upload Custom Icon 2 (Optional)" },
        { "type": "text", "id": "badge_2_text", "label": "Text 2", "default": "Handmade in CA" },

        { "type": "header", "content": "Badge 3" },
        {
          "type": "select",
          "id": "badge_3_icon",
          "label": "Preset Icon 3",
          "options": [
            { "value": "package", "label": "Eco Package" },
            { "value": "truck", "label": "Delivery Truck" },
            { "value": "shield", "label": "Security Shield" },
            { "value": "leaf", "label": "Organic Leaf" }
          ],
          "default": "package"
        },
        { "type": "image_picker", "id": "badge_3_custom_icon", "label": "Upload Custom Icon 3 (Optional)" },
        { "type": "text", "id": "badge_3_text", "label": "Text 3", "default": "Carbon Neutral" }
      ]
    },
    {
      "type": "custom_text",
      "name": "Custom Text Block",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Content", "default": "<p>Handmade with intention in California.</p>" }
      ]
    },
    { "type": "divider", "name": "Divider Line" },
    {
      "type": "accordion",
      "name": "Accordion Collapsible",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Treasure Details" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Share details about your piece here.</p>" },
        { "type": "checkbox", "id": "open_by_default", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Information",
      "blocks": [
        { "type": "title" },
        { "type": "price" },
        { "type": "variant_picker" },
        { "type": "quantity_selector" },
        { "type": "buy_buttons" },
        { "type": "trust_badges" },
        { "type": "accordion", "settings": { "heading": "The Story & Symbolism", "open_by_default": true } },
        { "type": "accordion", "settings": { "heading": "Treasure Details" } },
        { "type": "accordion", "settings": { "heading": "Shipping & Care" } }
      ]
    }
  ]
}
