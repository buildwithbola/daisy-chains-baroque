          "label": "Picker Type",
          "options": [
            { "value": "dropdown", "label": "Dropdown Menu" },
            { "value": "pills", "label": "Pill Buttons" }
          ],
          "default": "dropdown"
        }
      ]
    },
    { "type": "quantity_selector", "name": "Quantity Selector", "limit": 1 },
    {
      "type": "buy_buttons",
