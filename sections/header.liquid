{%- style -%}
  /* Top Announcement Bar 1 (White, Dismissable) */
  .announcement-bar-top {
    background-color: {{ section.settings.top_bar_bg | default: "#ffffff" }};
    color: {{ section.settings.top_bar_color | default: "#1c1c1c" }};
    font-family: var(--font-body-family);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding: 0.5rem 1.5rem;
    position: relative;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .announcement-bar-top a {
    color: inherit;
    text-decoration: none;
  }

  .announcement-bar-top__close {
    position: absolute;
    right: 1.25rem;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.25rem;
    display: flex;
    align-items: center;
  }

  .announcement-bar-top__close-svg {
    width: 14px;
    height: 14px;
    stroke: {{ section.settings.top_bar_color | default: "#1c1c1c" }};
    stroke-width: 1.5;
    fill: none;
  }

  /* Secondary Announcement Bar 2 (Warm Chocolate / Gold) */
  .announcement-bar-secondary {
    background-color: {{ section.settings.secondary_bar_bg | default: "#3b2314" }};
    color: {{ section.settings.secondary_bar_color | default: "#ffffff" }};
    font-family: var(--font-heading-family);
    font-size: 0.85rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    padding: 0.6rem 1.5rem;
    text-align: center;
  }

  .announcement-bar-secondary a {
    color: inherit;
    text-decoration: none;
  }

  /* Main Header Container */
  .site-header {
    background-color: {{ section.settings.header_bg | default: "#faf7f2" }};
    border-bottom: 1px solid {{ section.settings.header_border_color | default: "#e8e4dd" }};
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 0.85rem 1.5rem;
  }

  .site-header__top-row {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: {% if section.settings.show_search_bar %}0.75rem{% else %}0{% endif %};
  }

  .site-header__left-group {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .hamburger-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.4rem;
    display: flex !important;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    z-index: 10;
  }

  .hamburger-svg {
    width: 26px !important;
    height: 26px !important;
    stroke: {{ section.settings.header_text_color | default: "#1c1c1c" }} !important;
    stroke-width: 2.2 !important;
    fill: none !important;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .site-header__logo {
    font-family: var(--font-heading-family);
    font-size: {{ section.settings.logo_font_size | default: 32 }}px;
    font-weight: 300;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: {{ section.settings.header_text_color | default: "#1c1c1c" }};
    line-height: 1;
    display: flex;
    align-items: center;
  }

  .site-header__logo-img {
    max-width: {{ section.settings.logo_width | default: 160 }}px;
    height: auto;
    object-fit: contain;
  }

  /* Right Icon Actions Group */
  .site-header__right-icons {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-end !important;
    gap: 12px !important;
    z-index: 10;
    flex-shrink: 0 !important;
  }

  @media screen and (max-width: 767px) {
    .site-header__logo {
      font-size: {{ section.settings.mobile_logo_font_size | default: 20 }}px !important;
      letter-spacing: 0.05em !important;
      white-space: nowrap;
    }
    .site-header__logo-img {
      max-width: {{ section.settings.mobile_logo_width | default: 120 }}px !important;
    }
    .site-header__left-group {
      gap: 0.35rem !important;
      flex: 1;
      min-width: 0;
    }
    .site-header__right-icons {
      gap: 6px !important;
      flex-shrink: 0 !important;
    }
    .header-icon-btn {
      padding: 0.2rem !important;
      min-width: 30px !important;
      min-height: 30px !important;
    }
  }

  .header-icon-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.35rem;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    color: {{ section.settings.header_text_color | default: "#1c1c1c" }};
    text-decoration: none;
    position: relative;
    min-width: 36px;
    min-height: 36px;
  }

  .header-icon-svg {
    width: 22px !important;
    height: 22px !important;
    stroke: {{ section.settings.header_text_color | default: "#1c1c1c" }} !important;
    stroke-width: 1.8 !important;
    fill: none !important;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: fill 0.35s ease, stroke 0.35s ease;
  }

  .header-icon-btn:hover .header-icon-svg {
    fill: var(--color-accent, #c9a050);
    stroke: {{ section.settings.header_text_color | default: "#1c1c1c" }};
  }

  .cart-badge-count {
    position: absolute;
    top: -4px;
    right: -6px;
    background-color: {{ section.settings.header_text_color | default: "#1c1c1c" }};
    color: #ffffff;
    font-family: var(--font-body-family);
    font-size: 0.65rem;
    font-weight: 600;
    min-width: 16px;
    height: 16px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Full-Width Search Input Bar */
  .site-header__search-row {
    max-width: 1400px;
    margin: 0 auto;
  }

  .search-input-form {
    position: relative;
    width: 100%;
  }

  .search-input-field {
    width: 100%;
    padding: 0.65rem 3rem 0.65rem 1.25rem;
    font-family: var(--font-body-family);
    font-size: 0.88rem;
    border: 1px solid var(--color-border, #d1ccc4);
    border-radius: 24px;
    background-color: #ffffff;
    color: var(--color-text);
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .search-input-field:focus {
    outline: none;
    border-color: var(--color-text);
    box-shadow: 0 4px 15px rgba(0,0,0,0.04);
  }

  .search-input-submit {
    position: absolute;
    right: 0.85rem;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.35rem;
    display: flex;
    align-items: center;
  }

  .search-input-svg {
    width: 18px;
    height: 18px;
    stroke: #1c1c1c;
    stroke-width: 1.5;
    fill: none;
    transition: stroke 0.25s ease, fill 0.25s ease;
  }

  .search-input-submit:hover .search-input-svg {
    fill: var(--color-accent, #c9a050);
  }

  /* Slide-Out Navigation Drawer */
  .mobile-nav-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 85vw;
    max-width: 360px;
    height: 100vh;
    background-color: var(--color-background);
    z-index: 10001;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transform: translateX(-100%);
    transition: transform 0.35s cubic-bezier(0.25, 1, 0.5, 1);
    box-shadow: 10px 0 30px rgba(0,0,0,0.1);
  }

  .mobile-nav-drawer.active {
    transform: translateX(0);
  }

  .mobile-nav-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0,0,0,0.4);
    backdrop-filter: blur(4px);
    z-index: 10000;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .mobile-nav-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .mobile-nav-link {
    font-family: var(--font-heading-family);
    font-size: 1.4rem;
    font-weight: 300;
    color: var(--color-text);
    text-decoration: none;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
{%- endstyle -%}

<!-- Top Announcement Bar 1 (White, Dismissable) -->
{% if section.settings.show_top_bar %}
  <div class="announcement-bar-top" id="TopAnnouncementBar">
    {% if section.settings.top_bar_link != blank %}
      <a href="{{ section.settings.top_bar_link }}"><span>{{ section.settings.top_bar_text | escape }}</span></a>
    {% else %}
      <span>{{ section.settings.top_bar_text | escape }}</span>
    {% endif %}
    <button class="announcement-bar-top__close" onclick="document.getElementById('TopAnnouncementBar').style.display='none'" aria-label="Dismiss Announcement">
      <svg class="announcement-bar-top__close-svg" viewBox="0 0 24 24">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
{% endif %}

<!-- Secondary Announcement Bar 2 (Warm Chocolate / Gold) -->
{% if section.settings.show_secondary_bar %}
  <div class="announcement-bar-secondary">
    {% if section.settings.secondary_bar_link != blank %}
      <a href="{{ section.settings.secondary_bar_link }}"><span>{{ section.settings.secondary_bar_text | escape }}</span></a>
    {% else %}
      <span>{{ section.settings.secondary_bar_text | escape }}</span>
    {% endif %}
  </div>
{% endif %}

<!-- Main Header -->
<header class="site-header">
  <!-- Top Row: Hamburger + Logo + Right Icons -->
  <div class="site-header__top-row">
    <div class="site-header__left-group">
      <button class="hamburger-btn" id="MobileMenuBtn" aria-label="Open Navigation Menu">
        <svg class="hamburger-svg" viewBox="0 0 24 24" width="26" height="26" stroke="#1c1c1c" stroke-width="2.2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>

      <a href="{{ routes.root_url }}" class="site-header__logo">
        {% if section.settings.logo != blank %}
          <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" class="site-header__logo-img">
        {% else %}
          {{ section.settings.logo_text | default: shop.name | escape }}
        {% endif %}
      </a>
    </div>

    <!-- Right Actions Group -->
    <div class="site-header__right-icons">
      {% if section.settings.show_currency_selector %}
        <button class="header-icon-btn" title="Country / Currency" aria-label="Select Country">
          <span style="font-size:0.85rem; font-weight:600; line-height:1;">US</span>
        </button>
      {% endif %}

      {% if section.settings.show_account_icon %}
        <a href="{{ routes.account_url }}" class="header-icon-btn" title="Account" aria-label="Account">
          <svg class="header-icon-svg" viewBox="0 0 24 24" width="22" height="22" style="stroke:#1c1c1c !important; stroke-width:1.8px !important; fill:none !important; display:block;">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" stroke="#1c1c1c" stroke-width="1.8" fill="none"></path>
            <circle cx="12" cy="7" r="4" stroke="#1c1c1c" stroke-width="1.8" fill="none"></circle>
          </svg>
        </a>
      {% endif %}

      {% if section.settings.show_wishlist_icon %}
        <a href="/pages/wishlist" class="header-icon-btn" title="Wishlist" aria-label="Wishlist">
          <svg class="header-icon-svg" viewBox="0 0 24 24" width="22" height="22" style="stroke:#1c1c1c !important; stroke-width:1.8px !important; fill:none !important; display:block;">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" stroke="#1c1c1c" stroke-width="1.8" fill="none"></path>
          </svg>
          <span class="wishlist-badge-count" style="display:none;">0</span>
        </a>
      {% endif %}

      {% if section.settings.show_cart_icon %}
        <button class="header-icon-btn" onclick="openTreasureChest(); return false;" title="Treasure Chest Bag" aria-label="Treasure Chest Cart">
          <svg class="header-icon-svg" viewBox="0 0 24 24" width="22" height="22" style="stroke:#1c1c1c !important; stroke-width:1.8px !important; fill:none !important; display:block;">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" stroke="#1c1c1c" stroke-width="1.8" fill="none"></path>
            <line x1="3" y1="6" x2="21" y2="6" stroke="#1c1c1c" stroke-width="1.8"></line>
            <path d="M16 10a4 4 0 0 1-8 0" stroke="#1c1c1c" stroke-width="1.8" fill="none"></path>
          </svg>
          <span class="cart-badge-count" style="display:{% if cart.item_count > 0 %}flex{% else %}none{% endif %};">{{ cart.item_count }}</span>
        </button>
      {% endif %}
    </div>
  </div>

  <!-- Bottom Row: Full-Width Search Bar -->
  {% if section.settings.show_search_bar %}
    <div class="site-header__search-row">
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-input-form">
        <input type="search" name="q" class="search-input-field" placeholder="{{ section.settings.search_placeholder | default: 'Search gemstones, pearls, intention charms...' | escape }}" aria-label="Search treasures">
        <button type="submit" class="search-input-submit" aria-label="Submit Search">
          <svg class="search-input-svg" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
      </form>
    </div>
  {% endif %}
</header>

<!-- Mobile Navigation Drawer -->
<div class="mobile-nav-overlay" id="MobileNavOverlay"></div>
<div class="mobile-nav-drawer" id="MobileNavDrawer">
  <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--color-border); padding-bottom:1rem;">
    <span style="font-family:var(--font-heading-family); font-size:1.4rem; text-transform:uppercase; letter-spacing:0.08em; color:var(--color-text);">Daisy Chains</span>
    <button id="MobileNavClose" style="background:transparent; border:none; cursor:pointer; font-size:1.6rem; color:var(--color-text);" aria-label="Close Menu">&times;</button>
  </div>

  <div style="overflow-y:auto; flex:1; display:flex; flex-direction:column; gap:0.25rem; padding-right:0.25rem; margin-top:0.75rem;">
    {% assign mobile_menu_handle = section.settings.menu | default: 'main-menu' %}
    {% assign mobile_menu = linklists[mobile_menu_handle] %}
    {% if mobile_menu == blank or mobile_menu.links.size == 0 %}
      {% assign mobile_menu = section.settings.menu %}
    {% endif %}

    {% if mobile_menu != blank and mobile_menu.links.size > 0 %}
      {% for link in mobile_menu.links %}
        {% if link.links.size > 0 %}
          <div class="mobile-nav-item">
            <button class="mobile-nav-link" onclick="const sub = this.nextElementSibling; if(sub.style.display==='flex'){sub.style.display='none';}else{sub.style.display='flex';}" style="width:100%; background:transparent; border:none; cursor:pointer; text-align:left; padding:0.85rem 0; border-bottom:1px solid var(--color-border);">
              <span>{{ link.title | escape }}</span>
              <span style="font-weight:300; font-size:1.1rem;">+</span>
            </button>
            <div class="mobile-subnav-list" style="display:none; padding-left:0.85rem; flex-direction:column; gap:0.4rem; padding-top:0.5rem; padding-bottom:0.5rem; border-bottom:1px solid var(--color-border);">
              {% for childlink in link.links %}
                <a href="{{ childlink.url }}" style="font-family:var(--font-body-family); font-size:0.9rem; color:var(--color-text); text-decoration:none; padding:0.35rem 0; display:block;">{{ childlink.title | escape }}</a>
              {% endfor %}
            </div>
          </div>
        {% else %}
          <a href="{{ link.url }}" class="mobile-nav-link" style="padding:0.85rem 0; border-bottom:1px solid var(--color-border);">{{ link.title | escape }} <span>&rarr;</span></a>
        {% endif %}
      {% endfor %}
    {% else %}
      <a href="/collections/all" class="mobile-nav-link" style="padding:0.85rem 0; border-bottom:1px solid var(--color-border);">Shop All Treasures <span>&rarr;</span></a>
      <a href="/pages/symbols-and-stories" class="mobile-nav-link" style="padding:0.85rem 0; border-bottom:1px solid var(--color-border);">Meanings &amp; Symbolism Hub <span>&rarr;</span></a>
      <a href="/pages/bikini-charms" class="mobile-nav-link" style="padding:0.85rem 0; border-bottom:1px solid var(--color-border);">Bikini &amp; Beach Charms <span>&rarr;</span></a>
      <a href="/pages/custom-treasures" class="mobile-nav-link" style="padding:0.85rem 0; border-bottom:1px solid var(--color-border);">Custom Treasures &amp; Workshops <span>&rarr;</span></a>
      <a href="/pages/events" class="mobile-nav-link" style="padding:0.85rem 0; border-bottom:1px solid var(--color-border);">Events &amp; Pop-Up Markets <span>&rarr;</span></a>
      <a href="/pages/about" class="mobile-nav-link" style="padding:0.85rem 0; border-bottom:1px solid var(--color-border);">Our Story &amp; Founder Letter <span>&rarr;</span></a>
      <a href="/pages/values" class="mobile-nav-link" style="padding:0.85rem 0; border-bottom:1px solid var(--color-border);">Our Values <span>&rarr;</span></a>
    {% endif %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const btn = document.getElementById('MobileMenuBtn');
    const closeBtn = document.getElementById('MobileNavClose');
    const drawer = document.getElementById('MobileNavDrawer');
    const overlay = document.getElementById('MobileNavOverlay');

    function openMobileNav() {
      if (drawer) drawer.classList.add('active');
      if (overlay) overlay.classList.add('active');
    }

    function closeMobileNav() {
      if (drawer) drawer.classList.remove('active');
      if (overlay) overlay.classList.remove('active');
    }

    if (btn) btn.addEventListener('click', openMobileNav);
    if (closeBtn) closeBtn.addEventListener('click', closeMobileNav);
    if (overlay) overlay.addEventListener('click', closeMobileNav);
  });
</script>

{% schema %}
{
  "name": "Header & Navigation",
  "settings": [
    {
      "type": "header",
      "content": "Logo Settings"
    },
    { "type": "image_picker", "id": "logo", "label": "Custom Logo Image" },
    { "type": "text", "id": "logo_text", "label": "Text Logo Name", "default": "DAISY CHAINS" },
    { "type": "range", "id": "logo_width", "min": 60, "max": 300, "step": 10, "unit": "px", "label": "Desktop Logo Image Width", "default": 160 },
    { "type": "range", "id": "logo_font_size", "min": 18, "max": 48, "step": 2, "unit": "px", "label": "Desktop Text Logo Font Size", "default": 32 },
    { "type": "range", "id": "mobile_logo_width", "min": 40, "max": 200, "step": 5, "unit": "px", "label": "Mobile Logo Image Width", "default": 120 },
    { "type": "range", "id": "mobile_logo_font_size", "min": 14, "max": 32, "step": 1, "unit": "px", "label": "Mobile Text Logo Font Size", "default": 20 },
    {
      "type": "header",
      "content": "Navigation Menu"
    },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    {
      "type": "header",
      "content": "Top Announcement Bar 1 (White)"
    },
    { "type": "checkbox", "id": "show_top_bar", "label": "Show Top Bar", "default": true },
    { "type": "text", "id": "top_bar_text", "label": "Text", "default": "SIGN UP FOR 10% OFF YOUR FIRST ORDER" },
    { "type": "url", "id": "top_bar_link", "label": "Link" },
    { "type": "color", "id": "top_bar_bg", "label": "Background Color", "default": "#ffffff" },
    { "type": "color", "id": "top_bar_color", "label": "Text Color", "default": "#1c1c1c" },
    {
      "type": "header",
      "content": "Secondary Announcement Bar 2 (Dark)"
    },
    { "type": "checkbox", "id": "show_secondary_bar", "label": "Show Secondary Bar", "default": true },
    { "type": "text", "id": "secondary_bar_text", "label": "Text", "default": "FREE US DELIVERY ON ORDERS OVER $100" },
    { "type": "url", "id": "secondary_bar_link", "label": "Link" },
    { "type": "color", "id": "secondary_bar_bg", "label": "Background Color", "default": "#3b2314" },
    { "type": "color", "id": "secondary_bar_color", "label": "Text Color", "default": "#ffffff" },
    {
      "type": "header",
      "content": "Search Bar"
    },
    { "type": "checkbox", "id": "show_search_bar", "label": "Show Search Bar", "default": true },
    { "type": "text", "id": "search_placeholder", "label": "Search Placeholder", "default": "Search gemstones, pearls, intention charms..." },
    {
      "type": "header",
      "content": "Right Action Icons"
    },
    { "type": "checkbox", "id": "show_currency_selector", "label": "Show Country / Currency Selector", "default": true },
    { "type": "checkbox", "id": "show_account_icon", "label": "Show Account Profile Icon", "default": true },
    { "type": "checkbox", "id": "show_wishlist_icon", "label": "Show Wishlist Heart Icon", "default": true },
    { "type": "checkbox", "id": "show_cart_icon", "label": "Show Treasure Chest Cart Icon", "default": true },
    {
      "type": "range",
      "id": "header_icon_size",
      "min": 14,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "Icon Size",
      "default": 20
    },
    {
      "type": "range",
      "id": "header_icon_gap",
      "min": 8,
      "max": 36,
      "step": 2,
      "unit": "px",
      "label": "Icon Spacing / Gap",
      "default": 18
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "Icon Position Alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-end"
    },
    {
      "type": "header",
      "content": "Colors"
