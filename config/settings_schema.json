[
  {
    "name": "theme_info",
    "theme_name": "Daisy Chains OS 2.0",
    "theme_author": "Antigravity",
    "theme_version": "1.0.0",
    "theme_support_url": "https://shopify.com",
    "theme_documentation_url": "https://shopify.com"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "colors_background",
        "label": "Page Background",
        "default": "#FAF8F5"
      },
      {
        "type": "color",
        "id": "colors_text",
        "label": "Primary Text",
        "default": "#181818"
      },
      {
        "type": "color",
        "id": "colors_accent",
        "label": "Accent Color",
        "default": "#E5C158"
      },
      {
        "type": "color",
        "id": "colors_surface_warm",
        "label": "Card & Surface Background",
        "default": "#F4F0EA"
      },
      {
        "type": "color",
        "id": "colors_border",
        "label": "Border & Line Color",
        "default": "#E8E4DD"
      },
      {
        "type": "color",
        "id": "colors_muted",
        "label": "Muted Text",
        "default": "#767676"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading Font",
        "default": "playfair_display_n4"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body Font",
        "default": "inter_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 80,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Heading Font Scale",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout & Spacing",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 50,
        "default": 1400,
        "unit": "px",
        "label": "Maximum Page Width"
      },
      {
        "type": "range",
        "id": "grid_gap",
        "min": 12,
        "max": 40,
        "step": 4,
        "default": 24,
        "unit": "px",
        "label": "Grid Gap Space"
      }
    ]
  },
  {
    "name": "Product Cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_secondary_image",
        "default": true,
        "label": "Show Secondary Image on Hover"
      },
      {
        "type": "checkbox",
        "id": "show_vendor",
        "default": false,
        "label": "Show Vendor"
      },
      {
        "type": "select",
        "id": "product_card_alignment",
        "options": [
          { "value": "left", "label": "Left" },
          { "value": "center", "label": "Center" }
        ],
        "default": "left",
        "label": "Text Alignment"
      }
    ]
  },
  {
    "name": "Cart & Free Shipping",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "options": [
          { "value": "drawer", "label": "Cart Drawer" },
          { "value": "page", "label": "Page" }
        ],
        "default": "drawer",
        "label": "Cart Type"
      },
      {
        "type": "text",
        "id": "free_shipping_threshold",
        "label": "Free Shipping Threshold Amount ($)",
        "default": "150"
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram Handle or Link"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "Pinterest Link"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok Handle or Link"
      }
    ]
  },
  {
    "name": "Favicon & Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon Image"
      }
    ]
  }
]
